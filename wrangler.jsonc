{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lbasy",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [{ "binding": "THEMES", "id": "907df2ab45f84a6c9054d6733fa6ebf6" }],
  "d1_databases": [{"binding":"DB","database_name":"lbasy-store","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}]
}
