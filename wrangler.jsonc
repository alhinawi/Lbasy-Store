{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lbasy",
  "account_id": "bfdf917dfcbe6b01fba45e787205d20b",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [{ "binding": "THEMES", "id": "6d11db6815654dc492098c79383fceb5" }],
  "d1_databases": [{"binding":"DB","database_name":"lbasy","database_id":"5c067daa-625f-4d20-a675-feb7f1b7d9b1","migrations_dir":"migrations"}]
}
