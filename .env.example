# Copy to .env.local for local development. All values are optional locally.
# On Cloudflare, add them as build variables (they are baked into the build).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Leave both empty to run on sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin password in sample-data mode only (default lbasy2026).
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=

NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_ONLINE_PAYMENT=
