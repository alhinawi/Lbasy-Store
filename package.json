{
  "name": "lbasy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "pages:build": "opennextjs-cloudflare build && node scripts/build-pages.mjs",
    "pages:dev": "wrangler pages dev --cwd cloudflare --port 8788",
    "pages:deploy": "npm run pages:build && wrangler pages deploy --cwd cloudflare --project-name lbasy --branch main",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:generate": "tsx scripts/generate-d1-seed.ts",
    "db:seed:local": "npm run db:seed:generate && wrangler d1 execute DB --local --file .local/catalog-import.sql"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@supabase/supabase-js": "^2.119.0",
    "hono": "^4.13.19",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@opennextjs/cloudflare": "^1.20.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22"
  }
}
