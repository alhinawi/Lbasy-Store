// Cloudflare Pages project config, used by `npm run pages:deploy` and `npm run pages:dev`.
// It lives in its own folder (not `pages/`, which Next.js would read as a router) because the root wrangler.jsonc is the Worker config
// that `opennextjs-cloudflare build` reads to bundle the server.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lbasy",
  "account_id": "bfdf917dfcbe6b01fba45e787205d20b",
  "pages_build_output_dir": "../dist",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [{ "binding": "THEMES", "id": "6d11db6815654dc492098c79383fceb5" }],
  "d1_databases": [{"binding":"DB","database_name":"lbasy","database_id":"5c067daa-625f-4d20-a675-feb7f1b7d9b1","migrations_dir":"../migrations"}]
}
